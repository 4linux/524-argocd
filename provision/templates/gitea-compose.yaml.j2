# Gerenciado pelo provisionamento do laboratorio (provision/ci-tools.yaml)
services:
  server:
    container_name: gitea
    image: gitea/gitea:{{ gitea_version }}
    restart: always
    environment:
      - USER_UID=1000
      - USER_GID=1000
      - GITEA__database__DB_TYPE=sqlite3
      - GITEA__server__DOMAIN={{ gitea_host }}
      - GITEA__server__ROOT_URL=http://{{ gitea_host }}:3000/
      - GITEA__server__SSH_PORT=222
      # Instalacao ja concluida: dispensa o assistente do primeiro acesso
      - GITEA__security__INSTALL_LOCK=true
      - GITEA__security__SECRET_KEY={{ gitea_secret_key }}
      # Gitea Actions (CI)
      - GITEA__actions__ENABLED=true
      # WebHooks para enderecos da rede privada do laboratorio (Argo CD)
      - GITEA__security__ALLOWED_HOST_LIST=private
      - GITEA__webhook__SKIP_TLS_VERIFY=true
    volumes:
      - ./data:/data
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "3000:3000"
      - "222:22"
